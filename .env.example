# Justavalia — variáveis de ambiente (dev). Copie para .env: `cp .env.example .env`.
# NUNCA commitar .env. Guardrail #5: segredos só aqui / no secret manager.

# ---- Django ----
DJANGO_SETTINGS_MODULE=justavalia.core.settings.dev
DJANGO_SECRET_KEY=changeme-gere-uma-chave-real-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8010
# SHOW_STYLEGUIDE=True
# Porta do host onde o web é publicado (a 8000 pode estar tomada por túnel SSH). Container = 8000.
WEB_PORT=8010

# ---- Postgres (consumido pelo serviço postgres E pelo Django) ----
POSTGRES_DB=justavalia
POSTGRES_USER=justavalia
POSTGRES_PASSWORD=justavalia
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://justavalia:justavalia@postgres:5432/justavalia

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- MinIO / S3 (django-storages + boto3) ----
# AWS_ACCESS_KEY_ID/SECRET intencionalmente iguais a MINIO_ROOT_USER/PASSWORD.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=justavalia-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=False

# ---- Anthropic (adiado p/ Fase 5/6 — placeholder; fixar modelo via docs.claude.com) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ---- Switches de provedores (adapters default = mock em dev) ----
PIX_PROVIDER=mock
SIGNER_PROVIDER=mock
NOTIFIER_PROVIDER=console

# ---- Observabilidade (Fase 9 — vazio em dev) ----
SENTRY_DSN=
